# For local development, keep the API bound to localhost.
APP_ENV=development
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
SECRET_KEY=local-development-key-replace-for-production-0123456789abcdef
ALLOW_SIGNUP=1
COOKIE_SECURE=0

# Comma-separated browser origins allowed to call the API. Do not use * in production.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional absolute SQLite path. Defaults to backend/security.db.
# CYBER_SENTINEL_DB=/absolute/path/to/security.db

# Use shared storage (such as Redis) when running multiple API workers.
RATELIMIT_STORAGE_URI=memory://
